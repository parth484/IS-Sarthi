# Copy to .env and adjust. All variables are prefixed IS_.

IS_POSTGRES_URL=postgresql://is_sarthi:is_sarthi@localhost:5432/is_standards
IS_REDIS_URL=redis://localhost:6379/0
IS_NEO4J_URL=bolt://localhost:7687
IS_NEO4J_USER=neo4j
IS_NEO4J_PASSWORD=password123
IS_CHROMA_HOST=localhost
IS_CHROMA_PORT=8000

# Models
IS_EMBEDDING_MODEL=intfloat/multilingual-e5-base
IS_RERANKER_MODEL=BAAI/bge-reranker-base

# LLM: stub | anthropic | openai | local
# 'stub' produces deterministic template justifications and needs no key.
# 'local' targets an Ollama-compatible endpoint for on-premise deployment.
IS_LLM_PROVIDER=stub
IS_LLM_MODEL=claude-sonnet-4-6
IS_LLM_API_KEY=

# Sarvam AI (Multilingual STT, TTS & Translation: Hindi, Marathi, English, Telugu, Tamil)
SARVAM_API_KEY=

# Crawling politeness -- lower the rate, never raise it
IS_CRAWL_DELAY_SECONDS=1.5
IS_MAX_RETRIES=3
IS_USER_AGENT=IS-Sarthi/1.0 (SIH2026 academic research; contact: team@example.edu)

# Retrieval tuning
IS_DENSE_TOP_K=50
IS_RERANK_TOP_K=10
IS_FINAL_TOP_K=5
IS_GRAPH_DEPTH=2
IS_MIN_CONFIDENCE=0.35
